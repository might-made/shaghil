{
  "functions": {
    "api/generate.mjs": {
      "maxDuration": 30
    },
    "api/health.mjs": {
      "maxDuration": 30
    },
    "api/visual.mjs": {
      "maxDuration": 180
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
